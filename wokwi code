
#include <WiFi.h>
#include <PubSubClient.h>
#include <DHT.h>

// ===== KHAI BAO CHAN =====
#define MQ2_PIN 34
#define DHT_PIN 15
#define DHT_TYPE DHT22

#define PUMP_PIN 26
#define FAN_PIN 27

DHT dht(DHT_PIN, DHT_TYPE);

// ===== WIFI =====
const char* ssid = "Wokwi-GUEST";
const char* password = "";

// ===== MQTT =====
const char* mqtt_server = "broker.hivemq.com";
const int mqtt_port = 1883;

WiFiClient espClient;
PubSubClient client(espClient);

// ===== TOPIC =====
const char* gasTopic = "firealarm/demo/gas";
const char* tempTopic = "firealarm/demo/temperature";

const char* pumpCmd = "firealarm/demo/pump/cmd";
const char* fanCmd = "firealarm/demo/fan/cmd";

const char* pumpState = "firealarm/demo/pump/state";
const char* fanState = "firealarm/demo/fan/state";

// ===== TRANG THAI =====
bool pumpStatus = false;
bool fanStatus = false;

unsigned long lastSend = 0;

// ===== DIEU KHIEN OUTPUT =====
void updatePump(bool state) {
  pumpStatus = state;
  digitalWrite(PUMP_PIN, state ? HIGH : LOW);

  client.publish(pumpState, state ? "ON" : "OFF");
  Serial.println(state ? "PUMP: ON" : "PUMP: OFF");
}

void updateFan(bool state) {
  fanStatus = state;
  digitalWrite(FAN_PIN, state ? HIGH : LOW);

  client.publish(fanState, state ? "ON" : "OFF");
  Serial.println(state ? "FAN: ON" : "FAN: OFF");
}

// ===== NHAN LENH MQTT =====
void callback(char* topic, byte* payload,
              unsigned int length) {

  String message = "";

  for (int i = 0; i < length; i++) {
    message += (char)payload[i];
  }

  Serial.print("Nhan lenh: ");
  Serial.println(message);

  if (strcmp(topic, pumpCmd) == 0) {
    if (message == "ON") {
      updatePump(true);
    } else if (message == "OFF") {
      updatePump(false);
    }
  }

  if (strcmp(topic, fanCmd) == 0) {
    if (message == "ON") {
      updateFan(true);
    } else if (message == "OFF") {
      updateFan(false);
    }
  }
}

// ===== KET NOI WIFI =====
void connectWiFi() {
  Serial.print("Dang ket noi WiFi");

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi connected!");
  Serial.println(WiFi.localIP());
}

// ===== KET NOI MQTT =====
void reconnectMQTT() {
  while (!client.connected()) {
    Serial.print("Connecting MQTT...");

    String clientId = "ESP32-FireAlarm-";
    clientId += String((uint32_t)ESP.getEfuseMac(), HEX);

    if (client.connect(clientId.c_str())) {
      Serial.println("Connected!");

      client.subscribe(pumpCmd);
      client.subscribe(fanCmd);

      client.publish(pumpState,
                      pumpStatus ? "ON" : "OFF");

      client.publish(fanState,
                      fanStatus ? "ON" : "OFF");

    } else {
      Serial.print("Failed, rc=");
      Serial.println(client.state());
      delay(2000);
    }
  }
}

// ===== SETUP =====
void setup() {
  Serial.begin(115200);

  pinMode(MQ2_PIN, INPUT);
  pinMode(PUMP_PIN, OUTPUT);
  pinMode(FAN_PIN, OUTPUT);

  digitalWrite(PUMP_PIN, LOW);
  digitalWrite(FAN_PIN, LOW);

  dht.begin();

  connectWiFi();

  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(callback);
}

// ===== LOOP =====
void loop() {

  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }

  if (!client.connected()) {
    reconnectMQTT();
  }

  client.loop();

  if (millis() - lastSend >= 2000) {
    lastSend = millis();

    // Doc cam bien MQ2
    int gasValue = analogRead(MQ2_PIN);

    // Doc nhiet do DHT22
    float temperature = dht.readTemperature();

    // Hien thi Serial
    Serial.println("===== FIRE ALARM =====");

    Serial.print("Gas: ");
    Serial.println(gasValue);

    if (!isnan(temperature)) {
      Serial.print("Temperature: ");
      Serial.print(temperature);
      Serial.println(" *C");

      // Gui nhiet do len MQTT
      char tempData[16];
      snprintf(tempData, sizeof(tempData),
               "%.2f", temperature);

      client.publish(tempTopic, tempData);

    } else {
      Serial.println("DHT22 reading error!");
    }

    // Gui gia tri MQ2 len MQTT
    char gasData[16];
    snprintf(gasData, sizeof(gasData),
             "%d", gasValue);

    client.publish(gasTopic, gasData);

    Serial.println("======================");
  }
}
